{
  "name": "accessible-by-morning-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A reproducible accessibility repair demo with measured before and after evidence.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node backend/server.js",
    "demo": "node backend/cli.js",
    "demo:replay": "node scripts/replay.js",
    "demo:show": "node scripts/bootstrap.js",
    "verify:demo": "node scripts/verify-demo.js",
    "publish:prepare": "node scripts/publication.js",
    "test": "node --test tests/*.test.js",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "axe-core": "^4.10.3",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^13.5.0",
    "playwright": "^1.56.0"
  }
}
