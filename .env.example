# Optional: set in your shell or local .env, never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional managed preview transport: background or stream.
GEMINI_EXECUTION_MODE=background
# Local deterministic repair works without Google credentials.
PORT=3000
# Optional exact comma-separated origins for a trusted reverse proxy.
DEMO_PUBLIC_ORIGINS=
